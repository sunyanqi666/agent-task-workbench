# 复制为 .env 后按需修改；所有配置均有安全默认值，无 .env 也可直接启动（演示模式）。

# API 服务端口
API_PORT=3000

# SQLite 数据库文件路径（相对仓库根目录；默认 apps/api/data/workbench.db）
# DATABASE_URL=./apps/api/data/workbench.db

# 模型提供方：不配置时仅支持演示模式（demo）；live 模式的密钥仅服务端读取
# MODEL_PROVIDER=deepseek
# MODEL_API_KEY=
# OpenAI 兼容 chat completions 根地址与模型名（P3 live 模式）
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
# 注：任务可选模型由服务端受控目录（GET /api/v1/models）决定；
# MODEL_NAME 仅在任务未指定模型时作为回退值。
# 旧名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 被供应商停用，勿再使用。

# 单任务步数上限（只计模型轮次）、单轮工具调用数上限与单步超时（毫秒），P1 由 runner 强制执行
MAX_STEPS=20
MAX_TOOL_CALLS_PER_TURN=10
STEP_TIMEOUT_MS=60000

# demo 模型每步之间的固定延迟（毫秒）：让执行过程在 SSE 实时流中可见；0 为立即执行
DEMO_STEP_DELAY_MS=400

# ===== P5 账号 / 额度 / 账本 =====
# 单任务预估费用上限（元）：预估超过该值的 live 任务拒绝创建
MAX_TASK_BUDGET_CNY=10
# 单用户进行中任务数上限（默认 5）与创建频率（次/分钟，默认 10）：超出返回 429
MAX_USER_CONCURRENT_TASKS=5
USER_CREATE_RATE_PER_MINUTE=10
# 平台当日净流出告警阈值（元）：超过仅输出告警日志不阻断；0 或负数关闭
PLATFORM_DAILY_BUDGET_CNY=50
# 平台当日净流出硬上限（元）：当日流出 + 本次预估超限时拒绝创建/重试 live 任务（429）；
# 0 或负数关闭（默认 200，平台级兜底，优先级高于用户限额）
PLATFORM_DAILY_HARD_LIMIT_CNY=200

# ===== P5 支付与安全 =====
# 模拟充值端点开关：默认关闭；仅测试/演示环境显式开启，生产环境严禁开启
# ENABLE_MOCK_PAYMENTS=true
# 生产环境设为 production：会话 Cookie 追加 Secure 属性（仅经 HTTPS 传输）
# NODE_ENV=production
